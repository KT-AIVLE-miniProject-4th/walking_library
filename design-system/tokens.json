{
  "name": "Bone & Kombu",
  "version": 1,
  "meta": {
    "source": "Brand extraction of atticusfinchclothing.com.au (structure, type, spacing, radius, motion); colours replaced with Bone / Kombu Green / Café Noir."
  },
  "color": {
    "themes": [
      {
        "id": "light",
        "name": "Light"
      }
    ],
    "tokens": [
      {
        "name": "bone",
        "value": "#E5D7C4",
        "usage": "Page background, input background and text on kombu fills. Replaces #ffffff everywhere in the source."
      },
      {
        "name": "cafe-noir",
        "value": "#4B3621",
        "usage": "Body text, headings and links on bone (8.0:1). Replaces #111111 and #000000 text in the source."
      },
      {
        "name": "cafe-noir-muted",
        "value": "#6E5A44",
        "usage": "Secondary text, captions and input borders on bone (4.6:1). Replaces #474d53 (--color-input-border)."
      },
      {
        "name": "kombu-green",
        "value": "#354024",
        "usage": "Primary: primary button fill and border, select fill, active states. White button text (on-primary) on it 11.0:1; bone text 7.8:1. Replaces #112b46."
      },
      {
        "name": "kombu-green-hover",
        "value": "#2A331C",
        "usage": "Primary button hover and pressed fill. Darker than kombu-green so bone text stays above 9:1."
      },
      {
        "name": "on-primary",
        "value": "#ffffff",
        "usage": "Text on primary buttons, selects and accent/primary badges (kombu-green 11.0:1, kombu-green-hover 13.2:1, kombu-accent 7.0:1)."
      },
      {
        "name": "kombu-accent",
        "value": "#4F5E36",
        "usage": "Accent: secondary emphasis fills, tags, highlights. Bone text on it 5.0:1. Replaces #3f4f60."
      },
      {
        "name": "kombu-accent-hover",
        "value": "#435030",
        "usage": "Hover for kombu-accent. Replaces #4c5f73; darkened instead of lightened to keep bone text legible."
      },
      {
        "name": "line",
        "value": "rgba(75, 54, 33, 0.15)",
        "usage": "Default 2px button outline and soft dividers on bone. Replaces rgba(0,0,0,0.15)."
      },
      {
        "name": "line-strong",
        "value": "#4B3621",
        "usage": "1px hairline rules on header, footer and search input. Replaces the #111111 hairline."
      },
      {
        "name": "focus-ring",
        "value": "#354024",
        "usage": "Keyboard focus outline: 2px solid, 2px offset, on bone (7.8:1)."
      },
      {
        "name": "overlay",
        "value": "rgba(75, 54, 33, 0.01)",
        "usage": "Input hover background tint. Replaces rgba(0,0,0,0.01) (--color-input-hover-background)."
      }
    ]
  },
